        /* Unlock & Open Invitation Animation */
        function openInvitation() {
            const cover = document.getElementById('welcome-cover');
            const floatingControls = document.getElementById('floating-controls');

            // Slide out cover
            cover.classList.add('opacity-0', '-translate-y-full');
            setTimeout(() => {
                cover.style.display = 'none';
            }, 1000);

            // Show controls
            floatingControls.classList.remove('opacity-0');

            // Play background music audio
            playMusic();
        }

        /* Toggle Audio Player */
        function toggleMusic() {
            if (isAudioPlaying) {
                bgMusic.pause();
                musicIcon.classList.remove('animate-spin');
                isAudioPlaying = false;
            } else {
                playMusic();
            }
        }

        function playMusic() {
            bgMusic.play().then(() => {
                isAudioPlaying = true;
                musicIcon.classList.add('animate-spin');
            }).catch(err => {
                console.log("Audio autoplay restricted by browser", err);
            });
        }

        /* Countdown Timer Logic */
        function startCountdown() {
            const targetDate = new Date("May 24, 2026 08:00:00").getTime();

            setInterval(() => {
                const now = new Date().getTime();
                const distance = targetDate - now;

                if (distance < 0) return;

                const days = Math.floor(distance / (1000 * 60 * 60 * 24));
                const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
                const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
                const seconds = Math.floor((distance % (1000 * 60)) / 1000);

                document.getElementById("timer-days").innerText = days < 10 ? "0" + days : days;
                document.getElementById("timer-hours").innerText = hours < 10 ? "0" + hours : hours;
                document.getElementById("timer-mins").innerText = minutes < 10 ? "0" + minutes : minutes;
                document.getElementById("timer-secs").innerText = seconds < 10 ? "0" + seconds : seconds;
            }, 1000);
        }

