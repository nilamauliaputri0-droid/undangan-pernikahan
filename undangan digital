            document.getElementById('lang-id').className = lang === 'id' ? "px-2.5 py-0.5 rounded-full bg-javanese-gold text-javanese-deepGreen font-semibold transition-all" : "px-2.5 py-0.5 rounded-full text-gray-300 transition-all";
            document.getElementById('lang-en').className = lang === 'en' ? "px-2.5 py-0.5 rounded-full bg-javanese-gold text-javanese-deepGreen font-semibold transition-all" : "px-2.5 py-0.5 rounded-full text-gray-300 transition-all";

            document.querySelectorAll('[data-i18n]').forEach(el => {
                const key = el.getAttribute('data-i18n');
                if (translations[lang][key]) {
                    el.innerText = translations[lang][key];
                }
            });
        }
    </script>
