    <script>
        /* Interactive Application State & Controller */
        let isAudioPlaying = false;
        const bgMusic = document.getElementById('bg-music');
        const musicIcon = document.getElementById('music-icon');

        // Dynamic URL Params guest name parsing (e.g. ?to=Nama+Tamu)
        window.addEventListener('DOMContentLoaded', () => {
            const urlParams = new URLSearchParams(window.location.search);
            const guestName = urlParams.get('to') || urlParams.get('u') || 'Bapak/Ibu/Saudara/i';
            document.getElementById('guest-name-cover').innerText = guestName;
            
            // Load Saved Wishes
            renderWishes();
            
            // Start Live Countdown
            startCountdown();
