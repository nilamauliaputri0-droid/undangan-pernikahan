            const location = encodeURIComponent("Pendopo Ageng Handrawina, Surakarta");
            const url = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&dates=20260524T010000Z/20260524T070000Z&details=${details}&location=${location}`;
            window.open(url, '_blank');
        }

        /* Wish Comments LocalStorage Management */
        const defaultWishes = [
            { name: "Bambang & Keluarga", attendance: "Hadir", message: "Selamat untuk Arya & Sekar! Semoga menjadi keluarga yang Sakinah, Mawaddah, Warahmah." },
            { name: "Siti Rahma", attendance: "Hadir", message: "Matur nuwun undangannya. Lancar sampai hari H nggih!" }
        ];

        function getWishes() {
            const stored = localStorage.getItem('javanese_wedding_wishes');
            return stored ? JSON.parse(stored) : defaultWishes;
        }

        function submitWish(event) {
            event.preventDefault();
            const name = document.getElementById('wish-name').value;
            const attendance = document.getElementById('wish-attendance').value;
            const message = document.getElementById('wish-message').value;

            const wishes = getWishes();
            wishes.unshift({ name, attendance, message });
